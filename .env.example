# Copy to .env for local development (production uses /etc/sebastian/env).
SEBASTIAN_DATABASE_PATH=data/sebastian.db
# Generate with: uv run sebastian genkey
SEBASTIAN_API_KEY=change-me
# Generate with: uv run sebastian hash-password
SEBASTIAN_UI_PASSWORD_HASH=
# Random string for signing session cookies: uv run sebastian genkey
SEBASTIAN_SESSION_SECRET=change-me-too
# IANA timezone used for due times, quiet hours and "days"
SEBASTIAN_TIMEZONE=Europe/Berlin
SEBASTIAN_DEFAULT_NAG_INTERVAL_MIN=60
# Local-time window in which nothing is returned by /due ("none" disables)
SEBASTIAN_QUIET_HOURS=22:00-07:00
SEBASTIAN_HOST=127.0.0.1
SEBASTIAN_PORT=8000
