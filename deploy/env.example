# /etc/sebastian/env  (root:sebastian, mode 640). Never commit the real file.
# Values containing $ must be wrapped in single quotes.
SEBASTIAN_DATABASE_PATH=/var/lib/sebastian/sebastian.db
SEBASTIAN_API_KEY=__API_KEY__
SEBASTIAN_SESSION_SECRET=__SESSION_SECRET__
# Create with: sudo -u sebastian /opt/sebastian/.venv/bin/sebastian hash-password
SEBASTIAN_UI_PASSWORD_HASH=''
SEBASTIAN_TIMEZONE=Europe/Berlin
SEBASTIAN_DEFAULT_NAG_INTERVAL_MIN=60
SEBASTIAN_QUIET_HOURS=22:00-07:00
SEBASTIAN_HOST=127.0.0.1
SEBASTIAN_PORT=8000
