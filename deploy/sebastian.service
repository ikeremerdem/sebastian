[Unit]
Description=Sebastian - personal tasks, reminders, logs and notes for Hermes
After=network.target

[Service]
Type=simple
User=sebastian
Group=sebastian
WorkingDirectory=/opt/sebastian
EnvironmentFile=/etc/sebastian/env
ExecStart=/opt/sebastian/.venv/bin/sebastian serve
Restart=on-failure
RestartSec=3

# Hardening: the service may only write to its data directory.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/sebastian
PrivateTmp=true
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
